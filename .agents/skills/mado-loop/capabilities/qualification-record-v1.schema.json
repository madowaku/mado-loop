{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://github.com/madowaku/mado-loop/schema/qualification-record-v1.schema.json","title":"MADO Capability Qualification Source v1","type":"object","additionalProperties":false,"required":["schema_version","source_id","records"],"properties":{"schema_version":{"const":"1.0"},"source_id":{"type":"string","pattern":"^[a-z0-9][a-z0-9._-]{1,127}$"},"records":{"type":"array","items":{"$ref":"#/$defs/record"}}},"$defs":{"token":{"type":"string","minLength":1,"maxLength":256},"digest":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},"record":{"type":"object","additionalProperties":false,"required":["schema_version","id","capability_id","scope","decision","bound_manifest_digest","basis","approved_by"],"properties":{"schema_version":{"const":"1.0"},"id":{"type":"string","pattern":"^[a-z0-9][a-z0-9._-]{1,127}$"},"capability_id":{"type":"string","pattern":"^[a-z0-9][a-z0-9._-]{1,127}$"},"scope":{"type":"string","pattern":"^[a-z0-9][a-z0-9._:-]{0,127}$"},"decision":{"enum":["QUALIFY","CANARY","ADOPT","HOLD","DEGRADE","RETIRE"]},"bound_manifest_digest":{"$ref":"#/$defs/digest"},"basis":{"type":"object","additionalProperties":false,"required":["experiments"],"properties":{"experiments":{"type":"array","minItems":1,"uniqueItems":true,"items":{"$ref":"#/$defs/token"}},"evidence":{"type":"array","uniqueItems":true,"items":{"$ref":"#/$defs/token"}}}},"approved_by":{"$ref":"#/$defs/token"}}}}}