{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://github.com/madowaku/mado-loop/schema/shadow-evidence-receipt-v1.schema.json","title":"MADO Materialized Shadow Evidence Receipt v1","type":"object","additionalProperties":false,"required":["schema_version","receipt_id","captured_at","shadow_digest","context","legacy","g3_candidates","comparison","join_state","outcome_joined_at","execution","outcome"],"properties":{"schema_version":{"const":"1.0"},"receipt_id":{"type":"string"},"captured_at":{"type":"string","format":"date-time"},"shadow_digest":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},"context":{"type":"object"},"legacy":{"type":"object"},"g3_candidates":{"type":"array"},"comparison":{"type":"object"},"join_state":{"enum":["PENDING","JOINED"]},"outcome_joined_at":{"type":["string","null"],"format":"date-time"},"execution":{"type":["object","null"]},"outcome":{"type":["object","null"]}}}