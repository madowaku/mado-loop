{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://github.com/madowaku/mado-loop/schema/intent-contract-v1.schema.json","title":"MADO Intent Contract v1","type":"object","additionalProperties":false,"required":["schema_version","id","goal","domains","work_mode","required_proof","sensitivity","acceptance","preferences"],"properties":{"schema_version":{"const":"1.0"},"id":{"type":"string","minLength":1},"goal":{"type":"string","minLength":1},"domains":{"type":"array","minItems":1,"uniqueItems":true,"items":{"enum":["CODE","GAMEPLAY","UI","SPRITE","IMAGE","ANIMATION","ASSET_INTEGRATION","REFERENCE_TO_UI","PIXEL_ART","PLAYTEST","RELEASE"]}},"work_mode":{"enum":["observe","propose","modify","release"]},"required_proof":{"enum":["P0","P1","P2","P3","P4","P5"]},"sensitivity":{"enum":["public","private","secret"]},"acceptance":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["id","required","claim"],"properties":{"id":{"type":"string","minLength":1},"required":{"type":"boolean"},"claim":{"type":"string","minLength":1}}}},"preferences":{"type":"object","additionalProperties":false,"required":["coordination"],"properties":{"coordination":{"enum":["minimal","balanced","parallel_ok"]}}}}}