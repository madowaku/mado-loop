{
  "schema_version": "0.1",
  "id": "routing.skill-selection",
  "title": "Deterministic UI specialist selection",
  "domains": ["UI"],
  "task_file": "task.md",
  "tags": ["offline", "routing", "skill-selection"],
  "required_proof": [],
  "acceptance": [
    {
      "id": "routing.expected-skills",
      "kind": "test",
      "required": true,
      "description": "The UI task selects the expected first-party specialist candidates."
    },
    {
      "id": "routing.no-unrelated-skills",
      "kind": "invariant",
      "required": true,
      "description": "Manual-only web-game specialists are not introduced into a Godot UI task."
    },
    {
      "id": "routing.repeatable",
      "kind": "invariant",
      "required": true,
      "description": "Two identical routing calls return the same canonical payload."
    }
  ],
  "policy": {
    "sensitivity": "public",
    "network": "offline",
    "mutation": "none",
    "timeout_seconds": 30,
    "allowed_platforms": ["windows", "linux", "macos"]
  },
  "expected_paths": ["runner.json"]
}
